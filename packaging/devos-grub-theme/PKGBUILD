# Maintainer: Ehsan Fazli
# Built from this repository by scripts/build-repo.sh (SRS BLD-003).

pkgname=devos-grub-theme
pkgver=0.1.0
pkgrel=1
pkgdesc='DevOS GRUB theme'
arch=('any')
url='https://github.com/DevOS'
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=('grub')
source=()

_themedir="$startdir/../../boot/grub/themes/devos"

package() {
    install -d "$pkgdir/usr/share/grub/themes"
    cp -r --no-preserve=ownership "$_themedir" "$pkgdir/usr/share/grub/themes/devos"
    find "$pkgdir/usr/share/grub/themes/devos" -type d -exec chmod 755 {} +
    find "$pkgdir/usr/share/grub/themes/devos" -type f -exec chmod 644 {} +
    install -Dm644 "$startdir/../../boot/grub/default-grub" "$pkgdir/usr/share/devos/grub/default-grub"
    install -Dm644 "$_themedir/LICENSE-fonts" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-fonts"
}
